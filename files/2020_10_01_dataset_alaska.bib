
@misc{sydney_s_foks_water_2020,
	title = {Water quality and gas fluxes of {Interior} {Alaska} (2014-2018)},
	copyright = {Creative Commons Zero v1.0 Universal},
	url = {https://www.sciencebase.gov/catalog/item/5bb786b0e4b0fc368e906b09},
	doi = {10.5066/P9C6BDBQ},
	abstract = {This product consists of multiple tabular datasets and associated metadata of water quality information related to rivers, streams, and lakes in the Yukon River watershed between 2014 and 2018. This data release is apart of the National Aeronautics and Space Administration (NASA) funded Arctic-Boreal Vulnerability Experiment (ABoVE) and is an assessment of water quality and greenhouse gas fluxes within the interior of Alaska. Sampling frequency varied across locations, with some sites sampled twice a year or more.  Data consist of:  organic and inorganic carbon related species, carbon dioxide and methane gas fluxes calculated from manual chamber measurements, nitrogen species, carbon isotopes, oxygen and deuterium isotopes, cations, anions, trace metals, and various in situ measurements including: pH, water temperature, air temperature, barometric pressure, secchi depth, dissolved oxygen, turbidity, fluorescent dissolved organic matter, and specific conductance.},
	urldate = {2026-09-04},
	publisher = {U.S. Geological Survey},
	author = {Sydney S Foks and Mark M Dornblaser and Matthew J. Bogard and David E Butman and Dane A. Campbell and Sarah Ellen Johnston and Joshua C Koch and Ziyu Li and Robert G. M. Spencer and Sadie R. Textor and Elizabeth T Whiddon and Kimberly P Wickland and Rob Striegl},
	year = {2020},
	keywords = {water quality, water resources},
}
